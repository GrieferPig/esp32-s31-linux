CONFIG_LV_CONF_SKIP=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_OBSERVER=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
CONFIG_FREERTOS_HZ=1000

CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200

# ESP32-S31 TRM ch.24 LCD and Camera Controller, sections 24.3.7.2 and 24.5.2:
# I8080 TX uses the command and DOUT phases with LCD_CAM_LCD_RGB_MODE_EN cleared.
CONFIG_EXAMPLE_LCD_I80_CONTROLLER_ILI9341=y
CONFIG_EXAMPLE_I80_FULL_SCREEN_DEMO=y
# ESP32-S31 TRM ch.24 LCD_CAM, LCD_CLKCNT_N: IDF uses 80 MHz / 6 = 13.33 MHz.
# ILI9341 section 19.3.1 specifies a minimum 66 ns write cycle (75 ns here).
CONFIG_EXAMPLE_LCD_PIXEL_CLOCK_HZ=13000000
CONFIG_EXAMPLE_LCD_IMAGE_FROM_EMBEDDED_BINARY=y
# CONFIG_EXAMPLE_LCD_I80_COLOR_IN_PSRAM is not set
CONFIG_EXAMPLE_PIN_NUM_PCLK=40
CONFIG_EXAMPLE_PIN_NUM_DC=39
CONFIG_EXAMPLE_PIN_NUM_CS=38
CONFIG_EXAMPLE_PIN_NUM_RST=3
CONFIG_EXAMPLE_PIN_NUM_BK_LIGHT=-1
# Verified HiLetgo shield wiring: RDID4 0x9341 and all 64 GRAM pixels match.
CONFIG_EXAMPLE_PIN_NUM_DATA0=43
CONFIG_EXAMPLE_PIN_NUM_DATA1=42
CONFIG_EXAMPLE_PIN_NUM_DATA2=44
CONFIG_EXAMPLE_PIN_NUM_DATA3=45
CONFIG_EXAMPLE_PIN_NUM_DATA4=46
CONFIG_EXAMPLE_PIN_NUM_DATA5=47
CONFIG_EXAMPLE_PIN_NUM_DATA6=48
CONFIG_EXAMPLE_PIN_NUM_DATA7=49
CONFIG_EXAMPLE_PIN_NUM_RD=36
