CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-radio.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-radio.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=n
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MEMMAP=y
# Match the native A2DP/Wi-Fi coexistence topology: two FreeRTOS cores.  The
# compatibility bridge preserves each task's requested affinity and reports
# its executing HP hart; the Linux blob gate still serializes unsafe closed
# payload sections while a task is blocked, exactly where the native scheduler
# may hand work to its other core.
# CONFIG_FREERTOS_UNICORE is not set
# Keep the radio-only dependency build on the legacy local data path.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP is not set
# CONFIG_ESP_WIFI_GMAC_SUPPORT is not set
# CONFIG_ESP_WIFI_REMOTE_IN_IDF is not set
# CONFIG_ESP_WIFI_REMOTE_ENABLED is not set
# CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED is not set
# CONFIG_ESP_WIFI_REMOTE_EAP_ENABLED is not set
# CONFIG_ESP_MODEM_CLOCK_ENABLE_CHECKING is not set
# Linux does not currently hand the SHA GDMA engine to the relocated radio
# payload.  WPA startup otherwise spins forever in sha_hal_wait_idle(); retain
# the other accelerators and use mbedTLS software SHA for this S-mode build.
# CONFIG_MBEDTLS_HARDWARE_SHA is not set
# A protected-AP A/B test reaches STA_CONNECTED with an open P4 AP but stalls
# before association with WPA2.  The relocated S-mode payload does not yet own
# the AES peripheral handoff either, so keep WPA2 on mbedTLS software AES.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# Match the native S31 A2DP/Wi-Fi coexistence reference.  Linux owns its
# separate netdev handoff reserve, so inflating IDF MAC queues only extends
# queueing latency and consumes coexistence airtime without preventing Linux
# RX-ring drops.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
# CONFIG_ESP_WIFI_STATIC_TX_BUFFER is not set
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=6


# Bluetooth controller-only build for the Linux VHCI transport.  The Linux
# Bluetooth core owns the host side, so keep Bluedroid/NimBLE out of the blob.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CONTROLLER_ENABLED=y
# Expose both BR/EDR and LE through the Linux VHCI transport.  A2DP is a Linux
# host profile, but it requires the controller to advertise BR/EDR ACL support;
# BLE-only controllers cannot carry AVDTP media or AVRCP signalling.
# CONFIG_BTDM_CTRL_MODE_BLE_ONLY is not set
CONFIG_BTDM_CTRL_MODE_BTDM=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_ENABLED is not set
# The native coexistence benchmark leaves controller sleep disabled.  Keep the
# same policy while validating Linux so sleep entry/exit cannot alter the RF
# arbitration timing.
# CONFIG_BT_CTRL_SLEEP_ENABLE is not set

# Preserve all radio features, optimize the source-built IDF closure for size.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_COMPILER_OPTIMIZATION_PERF is not set
