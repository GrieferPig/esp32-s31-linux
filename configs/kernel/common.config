# CONFIG_BUILTIN_DTB is not set
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_FILE_LOCKING=y
CONFIG_RISCV_ISA_C=y
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_V_DEFAULT_ENABLE is not set
CONFIG_RISCV_ISA_ZBA=y
CONFIG_RISCV_ISA_ZBB=y
CONFIG_RISCV_ISA_ZBC=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_INPUT=y
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_INPUT_MOUSEDEV is not set
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_SWAP=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
# CONFIG_USB_UAS is not set
# CONFIG_ZRAM is not set
# CONFIG_ZRAM_BACKEND_LZO is not set
# CONFIG_ZRAM_DEF_COMP_LZORLE is not set
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_ZRAM_MEMORY_TRACKING is not set
# CONFIG_ZRAM_MULTI_COMP is not set
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_ESP32S31_COPROC_CONTEXT=y
# CONFIG_CSD_LOCK_WAIT_DEBUG is not set
# CONFIG_CSD_LOCK_WAIT_DEBUG_DEFAULT is not set
CONFIG_PREEMPT_VOLUNTARY=y
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT is not set
CONFIG_EPOLL=y
CONFIG_TIMERFD=y
CONFIG_DMATEST=y
CONFIG_HIGH_RES_TIMERS=y
# 1000 Hz Linux scheduling for the radio compat tasks (kthreads): finer
# CFS preemption, exact msecs_to_jiffies, precise delayed_work.  The
# payload FreeRTOS ABI tick is unchanged (s31_linux_tick_count still
# reports 10 ms units; s31_ticks_to_jiffies scales by HZ symbolically),
# so closed Wi-Fi/BT libraries observe identical wall-time behavior.
# CONFIG_HZ_100 is not set
# CONFIG_HZ_250 is not set
# CONFIG_HZ_300 is not set
CONFIG_HZ_1000=y
CONFIG_BT_ESP32S31=y
CONFIG_ESP32S31_WIFI=y
CONFIG_MAC80211=y
CONFIG_ESP32S31_WIFI_SOFTMAC=y
# CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE is not set
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_ESP32S31_RADIO_XIP=y
# Keep in-tree module exports plus the external XIP radio payload's imports.
# Native configuration supplies the generated radio symbol whitelist path.
CONFIG_TRIM_UNUSED_KSYMS=y
