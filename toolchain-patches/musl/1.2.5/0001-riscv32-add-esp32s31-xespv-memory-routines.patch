From 0f74c67715e7a99d36934bccf1afe0aaf1b18468 Mon Sep 17 00:00:00 2001
From: GrieferPig <grieferpig@localhost>
Date: Thu, 30 Jul 2026 22:30:00 +0800
Subject: [PATCH] riscv32: add ESP32-S31 Xespv memory routines

Use aligned 128-bit Xespv transfers for sufficiently large memcpy and
memset operations. Keep scalar paths for short or unaligned operations so
the routines never access outside the caller-provided range.
---
 src/string/riscv32/memcpy.S | 61 +++++++++++++++++++++++++++++
 src/string/riscv32/memset.S | 81 ++++++++++++++++++++++++++++++++++++++
 2 files changed, 142 insertions(+)
 create mode 100644 src/string/riscv32/memcpy.S
 create mode 100644 src/string/riscv32/memset.S

diff --git a/src/string/riscv32/memcpy.S b/src/string/riscv32/memcpy.S
new file mode 100644
index 0000000..c361001
--- /dev/null
+++ b/src/string/riscv32/memcpy.S
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: MIT */
+.text
+.align 2
+.global memcpy
+.type memcpy, @function
+memcpy:
+	mv	t6, a0
+	li	t0, 64
+	bltu	a2, t0, .Lcopy_words
+	or	t0, a0, a1
+	andi	t0, t0, 15
+	bnez	t0, .Lcopy_words
+
+.Lcopy64:
+	esp.vld.128.ip q0, a1, 16
+	esp.vld.128.ip q1, a1, 16
+	esp.vld.128.ip q2, a1, 16
+	esp.vld.128.ip q3, a1, 16
+	esp.vst.128.ip q0, a0, 16
+	esp.vst.128.ip q1, a0, 16
+	esp.vst.128.ip q2, a0, 16
+	esp.vst.128.ip q3, a0, 16
+	addi	a2, a2, -64
+	li	t0, 64
+	bgeu	a2, t0, .Lcopy64
+
+.Lcopy16:
+	li	t0, 16
+	bltu	a2, t0, .Lcopy_words
+	esp.vld.128.ip q0, a1, 16
+	esp.vst.128.ip q0, a0, 16
+	addi	a2, a2, -16
+	j	.Lcopy16
+
+.Lcopy_words:
+	or	t0, a0, a1
+	andi	t0, t0, 3
+	bnez	t0, .Lcopy_bytes
+.Lcopy_word_loop:
+	li	t0, 4
+	bltu	a2, t0, .Lcopy_bytes
+	lw	t1, 0(a1)
+	sw	t1, 0(a0)
+	addi	a1, a1, 4
+	addi	a0, a0, 4
+	addi	a2, a2, -4
+	j	.Lcopy_word_loop
+
+.Lcopy_bytes:
+	beqz	a2, .Lcopy_done
+.Lcopy_byte_loop:
+	lbu	t0, 0(a1)
+	sb	t0, 0(a0)
+	addi	a1, a1, 1
+	addi	a0, a0, 1
+	addi	a2, a2, -1
+	bnez	a2, .Lcopy_byte_loop
+.Lcopy_done:
+	mv	a0, t6
+	ret
+.size memcpy, .-memcpy
diff --git a/src/string/riscv32/memset.S b/src/string/riscv32/memset.S
new file mode 100644
index 0000000..40cac11
--- /dev/null
+++ b/src/string/riscv32/memset.S
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: MIT */
+.text
+.align 2
+.global memset
+.type memset, @function
+memset:
+	mv	t6, a0
+	andi	a1, a1, 255
+	li	t0, 64
+	bltu	a2, t0, .Lset_words
+
+	andi	t0, a0, 15
+	beqz	t0, .Lmake_pattern
+	li	t1, 16
+	sub	t0, t1, t0
+.Lalign_loop:
+	sb	a1, 0(a0)
+	addi	a0, a0, 1
+	addi	a2, a2, -1
+	addi	t0, t0, -1
+	bnez	t0, .Lalign_loop
+
+.Lmake_pattern:
+	li	t0, 0x01010101
+	mul	t1, a1, t0
+	addi	sp, sp, -16
+	sw	t1, 0(sp)
+	sw	t1, 4(sp)
+	sw	t1, 8(sp)
+	sw	t1, 12(sp)
+	mv	t3, sp
+	esp.vld.128.ip q0, t3, 0
+	addi	sp, sp, 16
+
+.Lset64:
+	li	t0, 64
+	bltu	a2, t0, .Lset16
+	esp.vst.128.ip q0, a0, 16
+	esp.vst.128.ip q0, a0, 16
+	esp.vst.128.ip q0, a0, 16
+	esp.vst.128.ip q0, a0, 16
+	addi	a2, a2, -64
+	j	.Lset64
+
+.Lset16:
+	li	t0, 16
+	bltu	a2, t0, .Lset_words
+	esp.vst.128.ip q0, a0, 16
+	addi	a2, a2, -16
+	j	.Lset16
+
+.Lset_words:
+	li	t0, 0x01010101
+	mul	t1, a1, t0
+	andi	t0, a0, 3
+	beqz	t0, .Lset_word_loop
+.Lset_head:
+	beqz	a2, .Lset_done
+	sb	a1, 0(a0)
+	addi	a0, a0, 1
+	addi	a2, a2, -1
+	andi	t0, a0, 3
+	bnez	t0, .Lset_head
+.Lset_word_loop:
+	li	t0, 4
+	bltu	a2, t0, .Lset_tail
+	sw	t1, 0(a0)
+	addi	a0, a0, 4
+	addi	a2, a2, -4
+	j	.Lset_word_loop
+.Lset_tail:
+	beqz	a2, .Lset_done
+.Lset_byte_loop:
+	sb	a1, 0(a0)
+	addi	a0, a0, 1
+	addi	a2, a2, -1
+	bnez	a2, .Lset_byte_loop
+.Lset_done:
+	mv	a0, t6
+	ret
+.size memset, .-memset
-- 
2.43.0
