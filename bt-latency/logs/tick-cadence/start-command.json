"S31_HCI_DEVICE=/dev/s31-hci S31_BTSTACK_PAIRABLE=1 S31_BTSTACK_COEX=0 S31_BTSTACK_BURST=24 S31_BTSTACK_SPP_BYTES=990 S31_BTSTACK_BLE_BYTES=495 S31_BTSTACK_INTERVAL=12 S31_BTSTACK_NAME=\"S31 Radio\" /usr/sbin/s31-btstack-a2dp -u 0 -l none >/tmp/tick-first.log 2>&1 & sleep 8; cat /tmp/tick-first.log; if ! grep -q \"up and running\" /tmp/tick-first.log; then killall s31-btstack-a2dp; sleep 2; S31_HCI_DEVICE=/dev/s31-hci S31_BTSTACK_PAIRABLE=1 S31_BTSTACK_COEX=0 S31_BTSTACK_BURST=24 S31_BTSTACK_SPP_BYTES=990 S31_BTSTACK_BLE_BYTES=495 S31_BTSTACK_INTERVAL=12 S31_BTSTACK_NAME=\"S31 Radio\" /usr/sbin/s31-btstack-a2dp -u 0 -l none >/tmp/tick-restart.log 2>&1 & sleep 8; cat /tmp/tick-restart.log; fi"