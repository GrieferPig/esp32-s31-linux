"echo READY; mkdir -p /tmp/cfg; printf \"enabled=1\\nindex=0\\nle=1\\n\" > /tmp/cfg/bluetooth.conf; export ESP32_CONFIG_DIR=/tmp/cfg S31_RADIO_VOLATILE_MODE=bt; /usr/sbin/s31-overlay apply radio-bluetooth --volatile; timeout -s KILL 90 /usr/sbin/s31-modload /usr/lib/s31-radio/esp32s31-radio.ko.xz mode=bt direct_hci=1; ls -l /dev/s31-hci"