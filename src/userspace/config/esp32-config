#!/bin/sh
# Persistent ESP32-S31 configuration. Modules define actions without applying
# settings merely because the frontend was opened.
set -u

ESP32_CONFIG_LIB_DIR="${ESP32_CONFIG_LIB_DIR:-/usr/lib/esp32-config}"
for module in common network bluetooth gpio storage usb system maintenance interfaces; do
	[ -r "$ESP32_CONFIG_LIB_DIR/$module.sh" ] || {
		printf 'esp32-config: missing configuration module %s\n' "$module" >&2
		exit 1
	}
	. "$ESP32_CONFIG_LIB_DIR/$module.sh"
done

show_status()
{
	printf 'Hostname: %s\n\n' "$(hostname 2>/dev/null)"
	maintenance_pending_message
	system_time_status
	printf '\nSTARTUP PROGRAM\n'
	system_userapp_status
	printf '\nNETWORK\n'
	network_status
	printf '\nBLUETOOTH\n'
	bt_info
	printf '\nINTERFACES\n'
	s31-overlay status || true
	printf '\nGPIO (current / saved)\n'
	gpio_status || true
	printf '\nMEMORY\n'
	free
	printf '\nSTORAGE\n'
	storage_status
	printf '\nUSB\n'
	usb_status
}

apply_all()
{
	local result=0 step code
	require_root
	ensure_config || return 1
	# Radio reconfiguration owns its Bluetooth-before-Wi-Fi ordering. This does
	# not run the user application or replace the active DT overlay collection.
	for step in system_apply system_extra_apply radio_reload_and_apply_all gpio_apply usb_apply storage_apply; do
		"$step"
		code=$?
		case "$code" in
			0) ;;
			2) [ "$result" -ne 0 ] || result=2 ;;
			*) result=1 ;;
		esac
	done
	return "$result"
}

main_menu()
{
	local choice
	while :; do
		choice="$(ui_dialog --stdout --clear --title 'ESP32-S31 Configuration' \
			--cancel-label Finish --menu \
			"$(display_ascii "$(hostname 2>/dev/null)")\nChoose a setting. Changes are saved when you apply them.\n$(maintenance_pending_message)${UI_NOTICE:+\n$UI_NOTICE}" 20 76 6 \
			1 'System            Hostname, password, time, startup program' \
			2 'Network           Wi-Fi, IPv4 address and DNS' \
			3 'Bluetooth         Radio, device name and saved pairings' \
			4 'Interfaces        Peripherals, GPIO and USB' \
			5 'Memory & storage  Swap and removable storage' \
			6 'Maintenance       Backup, restore and reset settings')" || return 0
		UI_NOTICE=''
		case "$choice" in
			1) system_menu ;;
			2) network_menu ;;
			3) bt_menu ;;
			4) interfaces_menu ;;
			5) storage_menu ;;
			6) maintenance_menu ;;
		esac
	done
}

run_menu()
{
	require_root
	ensure_config || die "cannot initialize $CONF_DIR"
	have dialog || die 'dialog is not installed'
	[ -t 0 ] && [ -t 1 ] && [ -t 2 ] || die 'interactive menu requires a terminal'
	ui_prepare_terminal
	ui_wait_for_startup
	"$1"
	ui_dialog --clear
	printf '\033[2J\033[H'
}

usage()
{
	cat <<'HELP'
Usage:
  esp32-config                         interactive configuration menu
  esp32-config status
  esp32-config apply [all|system|wifi|bluetooth|gpio|storage|usb]
  esp32-config stop                     stop managed Wi-Fi clients
  esp32-config system hostname [NAME]
  esp32-config system password
  esp32-config system time status|sync|set 'YYYY-MM-DD HH:MM:SS'
  esp32-config system time configure ZONE NTP_ENABLED SERVER
  esp32-config system autostart status|enable|disable|start|stop
  esp32-config system autostart configure EXECUTABLE [ARG ...]
  esp32-config wifi status|scan|configure|enable|disable|forget
  esp32-config wifi connect SSID [psk|open]
  esp32-config wifi configure-hex SSID_HEX [psk|open]
  esp32-config network status
  esp32-config network dhcp [auto|manual [DNS ...]]
  esp32-config network static ADDRESS PREFIX GATEWAY_OR_- [DNS ...]
  esp32-config bluetooth status|info|enable|disable|restart|clear-pairings
  esp32-config bluetooth name [NAME]
  esp32-config gpio list|apply|reset
  esp32-config gpio set LINE application|low|high
  esp32-config gpio set LINE input [none|up|down]
  esp32-config gpio read LINE
  esp32-config storage status|mount|unmount
  esp32-config storage swap enable DEVICE_OR_UUID
  esp32-config storage swap disable
  esp32-config storage configure DEVICE_OR_UUID PATH AUTOSTART READONLY
  esp32-config storage autostart 0|1
  esp32-config usb status
  esp32-config usb configure host|serial|network [SERIAL_LOGIN [IP/PREFIX]]
  esp32-config maintenance backup|restore ARCHIVE.tar
  esp32-config maintenance reset SECTION
  esp32-config overlay COMMAND [ARG ...]

Use SECTION menu to open a category directly (system, network, wifi,
bluetooth, interfaces, gpio, storage, usb, maintenance).

Wi-Fi connect reads one password from standard input; open networks do
not need a password. The legacy nonterminal wifi configure command reads
SSID, password and confirmation on three lines and only saves the profile.
Persistent settings are in /etc/esp32-conf. Restore/reset take effect at
restart. Applying all settings does not start the configured user program.

Legacy diagnostic commands remain available outside the configuration menu:
  esp32-config gpio info [CHIP]
  esp32-config gpio get CHIP LINE
  esp32-config gpio pulse CHIP LINE VALUE [SECONDS]
HELP
}

command="${1:-menu}"
[ "$#" -eq 0 ] || shift
case "$command" in
	-h|--help|help) usage; exit 0 ;;
	menu) [ "$#" -eq 0 ] || { usage; exit 2; }; run_menu main_menu; exit $? ;;
esac
# Configuration can contain credentials and these commands can affect hardware.
require_root
if [ "${1:-}" = menu ]; then
	[ "$#" -eq 1 ] || { usage; exit 2; }
	case "$command" in
		system) run_menu system_menu ;; network) run_menu network_menu ;;
		wifi) run_menu wifi_menu ;; bluetooth|bt) run_menu bt_menu ;;
		interfaces) run_menu interfaces_menu ;; gpio) run_menu gpio_menu ;;
		storage) run_menu storage_menu ;; usb) run_menu usb_menu ;;
		maintenance) run_menu maintenance_menu ;;
		*) usage; exit 2 ;;
	esac
	exit $?
fi
case "$command" in
	status) [ "$#" -eq 0 ] || { usage; exit 2; }; show_status ;;
	apply)
		[ "$#" -le 1 ] || { usage; exit 2; }
		ensure_config || exit 1
		case "${1:-all}" in
			all) apply_all ;;
			system) system_apply && system_extra_apply ;;
			wifi) wifi_apply ;;
			bluetooth|bt) bt_apply ;;
			gpio) gpio_apply ;;
			storage) storage_apply ;;
			usb) usb_apply ;;
			*) usage; exit 2 ;;
		esac ;;
	stop) [ "$#" -eq 0 ] || { usage; exit 2; }; wifi_stop ;;
	system) system_cli "$@" ;;
	wifi) wifi_cli "$@" ;;
	network) network_cli "$@" ;;
	bluetooth|bt) bluetooth_cli "$@" ;;
	gpio)
		case "${1:-}" in
			info)
				[ "$#" -le 2 ] || { usage; exit 2; }
				gpiodetect
				if [ "$#" -ge 2 ]; then valid_chip "$2" || die 'invalid GPIO chip'; gpioinfo -c "$2"; fi ;;
			get) [ "$#" -eq 3 ] || { usage; exit 2; }; gpio_get "$2" "$3" ;;
			pulse) [ "$#" -ge 4 ] && [ "$#" -le 5 ] || { usage; exit 2; }; gpio_pulse "$2" "$3" "$4" "${5:-3}" ;;
			*) gpio_cli "$@" ;;
		esac ;;
	storage) storage_cli "$@" ;;
	usb) usb_cli "$@" ;;
	maintenance) maintenance_cli "$@" ;;
	overlay) [ "$#" -gt 0 ] || { usage; exit 2; }; s31-overlay "$@" ;;
	*) usage; exit 2 ;;
esac
