BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVF=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ISA_EXTRA="zaamo_zalrsc_zba_zbb_zbc_zbs"
BR2_RISCV_32=y
BR2_RISCV_USE_MMU=y
BR2_RISCV_ABI_ILP32=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_PATH="$(BR2_EXTERNAL_ESP32_S31_PATH)/../toolchain/riscv32-esp-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="riscv32-esp-linux-musl"
BR2_TOOLCHAIN_EXTERNAL_GCC_15=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_6_12=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_MUSL=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TARGET_OPTIMIZATION="-Os -march=rv32imafbc_zicsr_zifencei_zaamo_zalrsc_zba_zbb_zbc_zbs -mabi=ilp32 -mtune=esp-base"
BR2_TARGET_GENERIC_HOSTNAME="esp32-s31"
BR2_TARGET_GENERIC_ISSUE="ESP32-S31 Linux (Buildroot)"
BR2_SYSTEM_DHCP="eth0"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-s31/busybox.fragment"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-s31/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-s31/post-build.sh"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_ESP32_S31_PATH)/patches"
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
# esp32-config intentionally requires the ncurses dialog frontend.
BR2_PACKAGE_DIALOG=y
# Use the standard Linux userspace control planes for the native cfg80211,
# Bluetooth HCI and GPIO character-device drivers.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
# BR2_PACKAGE_WPA_SUPPLICANT_WEXT is not set
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_HOSTAPD_DRIVER_NL80211=y
BR2_PACKAGE_LIBGPIOD2=y
BR2_PACKAGE_LIBGPIOD2_TOOLS=y
BR2_PACKAGE_LINUXPTP=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPIDEV_TEST=y
BR2_PACKAGE_ALSA_UTILS=y
# BR2_PACKAGE_ALSA_UTILS_ALSACTL is not set
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_LIB_PCM_PLUGINS="null extplug ioplug"
BR2_PACKAGE_ALSA_LIB_CTL_PLUGINS="ext"
# BR2_PACKAGE_ALSA_LIB_ALOAD is not set
# BR2_PACKAGE_ALSA_LIB_MIXER is not set
# BR2_PACKAGE_ALSA_LIB_RAWMIDI is not set
# BR2_PACKAGE_ALSA_LIB_HWDEP is not set
# BR2_PACKAGE_ALSA_LIB_SEQ is not set
# BR2_PACKAGE_ALSA_LIB_UCM is not set
# BR2_PACKAGE_ALSA_LIB_OLD_SYMBOLS is not set
# BR2_PACKAGE_ALSA_LIB_TOPOLOGY is not set
BR2_PACKAGE_CAN_UTILS=y
# BR2_PACKAGE_DROPBEAR is not set
# BR2_PACKAGE_IPROUTE2 is not set
BR2_PACKAGE_IW=y
# BR2_PACKAGE_MEMTESTER is not set
# BR2_PACKAGE_TCPDUMP is not set
BR2_PACKAGE_DTC=y
BR2_PACKAGE_COREMARK=y
BR2_PACKAGE_ESP_SIMD=y
BR2_PACKAGE_S31_TOOLS=y
BR2_PACKAGE_BTSTACK_S31=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_128K=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
BR2_TARGET_ROOTFS_SQUASHFS_EXTREME_COMP=y
# BR2_TARGET_ROOTFS_TAR is not set
