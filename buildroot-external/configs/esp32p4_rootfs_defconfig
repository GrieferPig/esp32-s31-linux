BR2_riscv=y
BR2_riscv_custom=y
BR2_RISCV_ISA_RVM=y
BR2_RISCV_ISA_RVA=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_32=y
# BR2_RISCV_USE_MMU is not set
BR2_RISCV_ABI_ILP32=y
BR2_KERNEL_HEADERS_6_18=y
BR2_TARGET_OPTIMIZATION="-Os -march=rv32imac_zicsr_zifencei -mabi=ilp32"
BR2_TARGET_GENERIC_HOSTNAME="esp32-p4"
BR2_TARGET_GENERIC_ISSUE="ESP32-P4 Linux (Buildroot NOMMU)"
BR2_INIT_BUSYBOX=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_GENERIC_GETTY_PORT="console"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_PACKAGE_BUSYBOX_CONFIG="package/busybox/busybox.config"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-s31/busybox.fragment $(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-p4/busybox.fragment"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-common/overlay $(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-p4/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-p4/post-build.sh"
# BR2_PACKAGE_ESP_SIMD is not set
BR2_PACKAGE_ESP32_DT=y
# BR2_PACKAGE_S31_TOOLS is not set
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_16K=y
BR2_TARGET_ROOTFS_SQUASHFS4_GZIP=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/GrieferPig/linux-esp32-s31.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="c57745752022e03d2248d397429345a1157dc7e4"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="esp32p4_reconstructed"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-p4/linux.config"
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="xipImage"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="espressif/esp32p4-generic espressif/esp32p4-waveshare-wifi6-dev-kit"
BR2_PACKAGE_P4_FIRMWARE=y
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_UBOOT_TOOLS_FIT_SUPPORT=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ESP32_S31_PATH)/board/esp32-p4/post-image.sh"
