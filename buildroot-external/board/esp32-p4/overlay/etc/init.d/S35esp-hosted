#!/bin/sh

case "$1" in
	start)
		module=/lib/modules/esp32_sdio.ko
		[ -r "$module" ] || exit 0
		# The MMC power sequence owns CHIP_PU. The driver registers on the
		# SDIO bus, which binds it when the C6 function is available.
		exec insmod "$module"
		;;
	stop)
		[ -d /sys/module/esp32_sdio ] || exit 0
		exec rmmod esp32_sdio
		;;
	*)
		echo "Usage: $0 {start|stop}" >&2
		exit 1
		;;
esac
