CONFIG_INSMOD=y
# Required for esp-hosted-ng's clockspeed, resetpin and ota_file module
# parameters.  Without it BusyBox silently loads the module with defaults.
CONFIG_FEATURE_CMDLINE_MODULE_OPTIONS=y
CONFIG_LSMOD=y
CONFIG_RMMOD=y

# ESP32-P4 NOMMU processes need one physically contiguous allocation for the
# whole FLAT image, including BSS and the configured stack.  Keep that runtime
# footprint below the 512 KiB buddy order so networking applets can still start
# after the SDIO/WLAN stack has fragmented memory.  These heavyweight applets
# are not needed by the bring-up rootfs; nc/ip and hexdump cover the removed
# network and hex utilities, while sha256sum remains available for integrity
# checks.
# CONFIG_ZCAT is not set
# CONFIG_BZCAT is not set
# CONFIG_LZCAT is not set
# CONFIG_XZCAT is not set
# CONFIG_FEATURE_BZIP2_DECOMPRESS is not set
# CONFIG_FEATURE_GZIP_DECOMPRESS is not set
# CONFIG_UNLZOP is not set
# CONFIG_LZOPCAT is not set
# CONFIG_BC is not set
# CONFIG_FEATURE_DC_BIG is not set
# CONFIG_FEATURE_BC_INTERACTIVE is not set
# CONFIG_FEATURE_BC_LONG_OPTIONS is not set
# CONFIG_MKE2FS is not set
# CONFIG_MKDOSFS is not set
# CONFIG_HEXEDIT is not set
# CONFIG_SETPRIV is not set
# CONFIG_FEATURE_SETPRIV_DUMP is not set
# CONFIG_FEATURE_SETPRIV_CAPABILITIES is not set
# CONFIG_FEATURE_SETPRIV_CAPABILITY_NAMES is not set
# CONFIG_SETSERIAL is not set
# CONFIG_SVC is not set
# CONFIG_SVOK is not set
# CONFIG_SSL_SERVER is not set
# CONFIG_TLS is not set
# CONFIG_TELNET is not set
# CONFIG_XXD is not set
# CONFIG_TSORT is not set
# CONFIG_SHA3SUM is not set
# CONFIG_SHA384SUM is not set
# CONFIG_SHA512SUM is not set
# CONFIG_WGET is not set
# CONFIG_NETSTAT is not set

# A login shell, wpa_supplicant and an interactive test shell can coexist on
# NOMMU only if each BusyBox FLAT image stays well below the 512 KiB buddy
# allocation.  Retain the small bring-up command set, but remove utilities and
# interactive-shell features which are not used by the P4 rootfs or tests.
# CONFIG_FEATURE_EDITING is not set
# CONFIG_FEATURE_EDITING_VI is not set
# CONFIG_FEATURE_EDITING_SAVEHISTORY is not set
