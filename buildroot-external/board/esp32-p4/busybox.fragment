# Keep the S31 applet selection on P4, with Hush for its NOMMU kernel.
CONFIG_SH_IS_HUSH=y
CONFIG_HUSH=y
CONFIG_HUSH_LOCAL=y
CONFIG_HUSH_UMASK=y
CONFIG_HUSH_COMMAND=y
CONFIG_HUSH_READ=y
CONFIG_HUSH_SET=y
CONFIG_HUSH_IF=y
CONFIG_HUSH_CASE=y
CONFIG_HUSH_LOOPS=y
CONFIG_HUSH_FUNCTIONS=y

CONFIG_FEATURE_IPV6=y
CONFIG_PING6=y
CONFIG_FEATURE_FANCY_PING=y
CONFIG_FLOCK=y
CONFIG_MOUNTPOINT=y
