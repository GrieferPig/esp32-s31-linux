CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_ESP32S31_I80=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_USB_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
# Root is SquashFS on MTD. Load USB mass storage and audio from rootfs
# to leave room for VT/fbcon in the existing 6 MiB XIP slot.
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_ESP32S31_I2S=m
# SquashFS compresses the installed modules; BusyBox loads the plain .ko files.
# CONFIG_MODULE_COMPRESS_ALL is not set
