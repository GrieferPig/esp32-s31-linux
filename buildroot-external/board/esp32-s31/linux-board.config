# Full board configuration retains all native board defconfig devices.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_I2C=y
CONFIG_SPI=y
CONFIG_CAN=y

CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_USB_HID=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
# Load USB mass storage and audio from the SquashFS rootfs.
CONFIG_SCSI=m
CONFIG_BLK_DEV_SD=m
CONFIG_USB_STORAGE=m
CONFIG_SOUND=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_SND_SOC_ESP32S31_I2S=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SOC_ES8311=m
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m
CONFIG_REGULATOR_FIXED_VOLTAGE=y
# SquashFS compresses the installed modules; BusyBox loads the plain .ko files.
# CONFIG_MODULE_COMPRESS_ALL is not set
# CONFIG_FB_ESP32S31_I80 is not set
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
