#!/bin/sh
# Early board setup; module parameters and blacklists use native modprobe files.
start()
{
	grep -qw 's31.radio_autoload=0' /proc/cmdline && return 0
	[ ! -d /sys/module/esp32s31_radio ] || return 0
	if ! grep -qx okay /proc/device-tree/soc/radio/status 2>/dev/null; then
		s31-overlay apply radio-combo --volatile || return 1
	fi
	sync
	[ ! -w /proc/sys/vm/drop_caches ] || echo 3 > /proc/sys/vm/drop_caches
	modprobe -b esp32s31_radio
}

stop()
{
	[ ! -d /sys/module/esp32s31_radio ] || rmmod esp32s31_radio
}

case "${1:-}" in
	start) start ;;
	stop) stop ;;
	restart) stop && start ;;
	*) echo "Usage: $0 {start|stop|restart}" >&2; exit 2 ;;
esac
