#!/bin/sh

set -eu

case "${1:-}" in
start)
	for path in /sys/class/remoteproc/remoteproc*; do
		[ -r "$path/name" ] || continue
		[ "$(cat "$path/name")" = esp32s31-lp ] || continue
		if [ "$(cat "$path/state")" = attached ] &&
			[ "$(cat "$path/device/ready")" = 1 ]; then
			exit 0
		fi
		break
	done
	echo 'ESP32-S31 LP firmware is not attached' >&2
	exit 1
	;;
stop) exit 0 ;;
*) echo "usage: $0 {start|stop}" >&2; exit 2 ;;
esac
