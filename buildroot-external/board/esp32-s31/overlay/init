#!/bin/sh

set -u

mount -t devtmpfs devtmpfs /dev 2>/dev/null || {
	mknod /dev/console c 5 1 2>/dev/null || true
	mknod /dev/ttyS0 c 4 64 2>/dev/null || true
}

mkdir -p /dev/pts

for tty in /dev/console /dev/ttyS0 /dev/hvc0; do
	[ -c "$tty" ] && exec <"$tty" >"$tty" 2>&1 && break
done

mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true

# The immutable root contains these mountpoints. Recovery must prepare the
# same writable runtime directories as a successful pivot; otherwise BusyBox
# init cannot start rcS or preserve its diagnostics on a read-only SquashFS.
mount_volatile_dir()
{
	_volatile_path="$1"
	_volatile_options="$2"
	mountpoint -q "$_volatile_path" && return 0
	if ! mount -t tmpfs -o "$_volatile_options" tmpfs "$_volatile_path"; then
		echo "S31 init: failed to mount volatile $_volatile_path" >&2
		return 1
	fi
}

prepare_volatile_dirs()
{
	_volatile_failed=0
	if mount_volatile_dir /run mode=0755,nosuid,nodev; then
		mkdir -p /run/lock /run/seedrng && chmod 0700 /run/seedrng ||
			_volatile_failed=1
	else
		_volatile_failed=1
	fi
	mount_volatile_dir /tmp mode=1777,nosuid,nodev || _volatile_failed=1
	mount_volatile_dir /var/log mode=0755,nosuid,nodev || _volatile_failed=1
	return "$_volatile_failed"
}

enter_recovery()
{
	echo 'S31 recovery: using read-only root; persistent settings unavailable' >&2
	prepare_volatile_dirs ||
		echo 'S31 recovery: some volatile directories are unavailable' >&2
	exec /sbin/init
}

# The rootfs is SquashFS. Keep the writable JFFS2 store in the early-boot
# staging tree while the overlay is assembled. After pivot_root the staging
# tree is detached; only the merged root remains visible. Identify the store by
# its ESP-IDF label, not a fixed MTD number.
persist_dev=""
for _try in $(seq 1 50); do
	for name_path in /sys/class/mtd/mtd*/name; do
		[ -r "$name_path" ] || continue
		[ "$(cat "$name_path")" = persist ] || continue
		mtd_name="${name_path#/sys/class/mtd/mtd}"
		mtd_name="${mtd_name%/name}"
		if [ -b "/dev/mtdblock${mtd_name}" ]; then
			persist_dev="/dev/mtdblock${mtd_name}"
			break 2
		fi
	done
	sleep 0.1
done

if [ -z "$persist_dev" ]; then
	echo "S31 overlay: persist MTD block device not found" >&2
	enter_recovery
fi

# /mnt is part of the immutable root, so use a temporary mount there for the
# overlay construction. A freshly erased NOR partition is a valid empty JFFS2
# filesystem and does not need a separate mkfs operation on the target.
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /mnt || {
	echo "S31 overlay: failed to allocate staging tmpfs" >&2
	enter_recovery
}
mkdir -p /mnt/store /mnt/newroot
if ! mount -t jffs2 "$persist_dev" /mnt/store; then
	echo "S31 overlay: failed to mount persist as JFFS2" >&2
	enter_recovery
fi

mkdir -p /mnt/store/upper /mnt/store/work

# Migrate the previous direct-JFFS2 configuration into the path it has in the
# OverlayFS upperdir. Do this before mounting the merged root so the raw backend
# never needs a runtime mountpoint. Remove an old file only after an identical
# destination exists.
config_upper=/mnt/store/upper/etc/esp32-conf
legacy_direct=/mnt/store/esp32-conf
mkdir -p "$config_upper"
chmod 0700 "$config_upper"
if [ -d "$legacy_direct" ]; then
	for config_name in system.conf wifi.conf bluetooth.conf overlays.conf wpa_supplicant.conf; do
		old_config="$legacy_direct/$config_name"
		new_config="$config_upper/$config_name"
		[ -f "$old_config" ] || continue
		if [ ! -e "$new_config" ]; then
			cp -p "$old_config" "$new_config" || continue
		fi
		cmp -s "$old_config" "$new_config" && rm -f "$old_config"
	done
	rmdir "$legacy_direct" 2>/dev/null || true
fi

# Older images created an otherwise-empty /persist mountpoint in the upperdir.
# Remove only an empty directory; never recursively delete data.
rmdir /mnt/store/upper/persist 2>/dev/null || true

# Package-owned radio userspace files were copied into the writable layer by
# older development images.  Such copies shadow the current SquashFS forever,
# which can silently keep an old A2DP-only BTstack binary after an update.
# Drop only the known package paths before assembling the overlay.  Persistent
# pairing keys and all files below /etc/esp32-conf remain untouched.
for package_path in \
        usr/sbin/s31-btstack-a2dp \
        etc/init.d/S40btstack \
        etc/init.d/S40bluetoothd \
        etc/init.d/S42s31-a2dp \
        usr/sbin/bluetoothd \
        usr/bin/bluealsa \
        usr/sbin/s31-bt-agent \
        etc/bluetooth/main.conf; do
        rm -f "/mnt/store/upper/$package_path"
done

# Device-tree overlays are firmware supplied by the immutable image.  Remove
# stale copies of those same packaged names from the writable upperdir so a
# rootfs update cannot keep loading an older or interrupted console upload.
for package_overlay in /usr/lib/s31-overlays/*.dtbo; do
        [ -e "$package_overlay" ] || continue
        rm -f "/mnt/store/upper/${package_overlay#/}"
done

if ! mount -t overlay overlay \
	-o lowerdir=/,upperdir=/mnt/store/upper,workdir=/mnt/store/work,\
index=off,redirect_dir=off /mnt/newroot; then
	echo "S31 overlay: failed to mount overlayfs" >&2
	enter_recovery
fi

mkdir -p /mnt/newroot/oldroot
if ! pivot_root /mnt/newroot /mnt/newroot/oldroot; then
	echo "S31 overlay: pivot_root failed" >&2
	enter_recovery
fi
cd /
umount -l /oldroot 2>/dev/null || true

# Recreate volatile mounts in the merged root. They do not consume JFFS2
# space and are not copied up into the persistent upperdir.
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mount -t proc proc /proc 2>/dev/null || true
mount -t sysfs sysfs /sys 2>/dev/null || true
mount -t devpts devpts /dev/pts 2>/dev/null || true
prepare_volatile_dirs ||
	echo 'S31 init: some volatile directories are unavailable' >&2

# Configuration belongs in the standard /etc hierarchy and is retained by the
# root OverlayFS writable layer.
config_dir=/etc/esp32-conf
mkdir -p "$config_dir"
chmod 0700 "$config_dir"

# Migrate the older /etc/s31-conf naming scheme without replacing files from
# the direct-JFFS2 migration above.
if [ -d /etc/s31-conf ]; then
	for old_config in /etc/s31-conf/*.conf; do
		[ -f "$old_config" ] || continue
		old_name="${old_config##*/}"
		new_name="$old_name"
		[ "$old_name" = s31-overlay.conf ] && new_name=overlays.conf
		[ -e "$config_dir/$new_name" ] ||
			cp -p "$old_config" "$config_dir/$new_name"
	done
fi
if [ ! -e "$config_dir/wpa_supplicant.conf" ] &&
	grep -q '^[[:space:]]*network={[[:space:]]*$' /etc/wpa_supplicant.conf 2>/dev/null; then
	cp -p /etc/wpa_supplicant.conf "$config_dir/wpa_supplicant.conf"
fi
chmod 0600 "$config_dir"/*.conf 2>/dev/null || true

# Retire exact init-script names shipped by older images.  They can survive in
# an incremental Buildroot target tree or in the writable OverlayFS upperdir
# and would otherwise apply the radio/configuration policy a second time.
rm -f /etc/init.d/S03s31-overlay /etc/init.d/S04s31-radio \
	/etc/init.d/S35esp32-config

# Restore the persisted DT overlay before loading the composite module.  The
# selection is recorded in /run for diagnostics and all later policy calls.
/usr/sbin/s31-overlay restore ||
	echo 'S31 early overlay restore failed; continuing with the base DT' >&2

# Load the selected integrated-radio overlay/module before BusyBox init starts
# rcS and getty concurrently.  The module's relocation window is the system's
# RAM high-water mark; keeping PID 1 as the only shell during that window
# avoids the low-memory OOM race without changing the persisted overlay choice.
if ! grep -qw 's31.radio_autoload=0' /proc/cmdline 2>/dev/null; then
	/etc/init.d/S00s31-radio start ||
		echo 'S31 early radio load failed; continuing in recovery mode' >&2
fi

# The compressed radio module is read from SquashFS and expanded before its
# long-lived allocations settle in PSRAM/SRAM.  Its input pages are disposable,
# but on this 16 MiB system retaining them through userspace service startup can
# push an otherwise healthy boot into the OOM killer.  Flush only completed
# writes, then discard reclaimable caches before handing control to init.
sync
echo 3 >/proc/sys/vm/drop_caches 2>/dev/null || true

exec /sbin/init
