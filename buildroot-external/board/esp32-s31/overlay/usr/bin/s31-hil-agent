#!/bin/sh

# Machine-readable, board-safe ESP32-S31 HIL entry point.  Tests which require
# an electrically connected peer must be reported as SKIP until that peer is
# explicitly enabled by the caller.

set -u

CASE=firmware
PEER_CONNECTED=0
ALLOW_USB_WRITE=0
LOCAL_IP=192.168.77.2/24
PEER_IP=192.168.77.1
PASS_COUNT=0
FAIL_COUNT=0
SKIP_COUNT=0

usage()
{
	echo "usage: $0 [--case firmware|peer|sdmmc|ethernet|usb-drive|mtd|lp-core|smp-irq-dma|all]" >&2
	echo "          [--peer-connected] [--allow-usb-write]" >&2
	echo "          [--local-ip CIDR] [--peer-ip ADDRESS]" >&2
}

while [ "$#" -gt 0 ]; do
	case "$1" in
	--case)
		[ "$#" -ge 2 ] || { usage; exit 2; }
		CASE="$2"
		shift 2
		;;
	--peer-connected)
		PEER_CONNECTED=1
		shift
		;;
	--allow-usb-write)
		ALLOW_USB_WRITE=1
		shift
		;;
	--local-ip)
		[ "$#" -ge 2 ] || { usage; exit 2; }
		LOCAL_IP="$2"
		shift 2
		;;
	--peer-ip)
		[ "$#" -ge 2 ] || { usage; exit 2; }
		PEER_IP="$2"
		shift 2
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		usage
		exit 2
		;;
	esac
done

json_escape()
{
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

emit()
{
	_emit_status="$1"
	_emit_name="$2"
	_emit_level="$3"
	_emit_detail="$4"
	printf 'HIL1 {"board":"esp32-s31","status":"%s","test":"%s","level":"%s","detail":"%s"}\n' \
		"$(json_escape "$_emit_status")" "$(json_escape "$_emit_name")" \
		"$(json_escape "$_emit_level")" "$(json_escape "$_emit_detail")"
	case "$_emit_status" in
	PASS) PASS_COUNT=$((PASS_COUNT + 1)) ;;
	FAIL) FAIL_COUNT=$((FAIL_COUNT + 1)) ;;
	SKIP) SKIP_COUNT=$((SKIP_COUNT + 1)) ;;
	esac
}

active_overlay()
{
	s31-overlay status 2>/dev/null | grep -q "^active: $1 "
}

probe_overlay()
{
	_probe_name="$1"
	shift
	if ! command -v s31-overlay >/dev/null 2>&1; then
		emit FAIL "overlay.$_probe_name" probe "s31-overlay is unavailable"
		return
	fi
	if active_overlay "$_probe_name"; then
		emit SKIP "overlay.$_probe_name" probe "already active; left unchanged"
		return
	fi
	if output="$(s31-overlay apply "$_probe_name" "$@" --volatile 2>&1)"; then
		if s31-overlay status 2>/dev/null | grep -q "^active: $_probe_name "; then
			emit PASS "overlay.$_probe_name.apply" probe "applied and registered"
		else
			emit FAIL "overlay.$_probe_name.apply" probe "apply returned success but overlay is absent"
		fi
		if s31-overlay remove "$_probe_name" --volatile >/dev/null 2>&1; then
			emit PASS "overlay.$_probe_name.remove" probe "removed; pinctrl should return high-Z"
		else
			emit FAIL "overlay.$_probe_name.remove" probe "remove failed"
		fi
	else
		emit FAIL "overlay.$_probe_name.apply" probe "$output"
	fi
}

probe_smoke_overlay()
{
	_smoke_name="$1"
	if active_overlay "$_smoke_name"; then
		emit SKIP "standalone.$_smoke_name" probe "already active; left unchanged"
		return
	fi
	if ! _smoke_apply="$(s31-overlay apply "$_smoke_name" --volatile 2>&1)"; then
		emit FAIL "standalone.$_smoke_name.apply" probe "$_smoke_apply"
		return
	fi
	if bounded_run 30 s31-peripheral-test "$_smoke_name"; then
		emit PASS "standalone.$_smoke_name.operation" data \
			"$(printf '%s\n' "$BOUNDED_OUTPUT" | tail -n 1)"
	else
		emit FAIL "standalone.$_smoke_name.operation" data \
			"$(printf '%s\n' "$BOUNDED_OUTPUT" | tail -n 1)"
	fi
	if s31-overlay remove "$_smoke_name" --volatile >/dev/null 2>&1; then
		emit PASS "standalone.$_smoke_name.cleanup" probe "temporary overlay removed"
	else
		emit FAIL "standalone.$_smoke_name.cleanup" probe "temporary overlay removal failed"
	fi
}

check_routes()
{
	name="$1"
	shift
	if ! routes="$(s31-overlay routes "$name" 2>/dev/null)"; then
		emit FAIL "routes.$name" probe "route metadata unavailable"
		return
	fi
	for route in "$@"; do
		if printf '%s\n' "$routes" | grep -q "^$route="; then
			emit PASS "routes.$route" probe "route is patchable"
		else
			emit FAIL "routes.$route" probe "route missing from DTBO"
		fi
	done
}

firmware_tests()
{
	model="$(tr -d '\000' </proc/device-tree/model 2>/dev/null || true)"
	case "$model" in
	*ESP32-S31*) emit PASS board.identity probe "$model" ;;
	*) emit FAIL board.identity probe "unexpected model: ${model:-unknown}" ;;
	esac

	if [ -e /sys/devices/system/cpu/cpu0/online ] || [ -d /sys/devices/system/cpu/cpu0 ]; then
		online="$(cat /sys/devices/system/cpu/online 2>/dev/null || echo 0)"
		case "$online" in
		0-1|0,1) emit PASS cpu.smp probe "online=$online" ;;
		*) emit FAIL cpu.smp probe "expected two online CPUs, got $online" ;;
		esac
	else
		emit FAIL cpu.smp probe "CPU sysfs unavailable"
	fi

	if [ -c /dev/s31-overlay ]; then
		emit PASS overlay.manager probe "/dev/s31-overlay present"
	else
		emit FAIL overlay.manager probe "/dev/s31-overlay missing"
	fi

	if command -v s31-peripheral-test >/dev/null 2>&1; then
		if output="$(s31-peripheral-test 2>&1)"; then
			detail="$(printf '%s\n' "$output" | tail -n 1)"
			emit PASS peripheral.probe probe "$detail"
		else
			detail="$(printf '%s\n' "$output" | tail -n 1)"
			emit FAIL peripheral.probe probe "$detail"
		fi
	else
		emit FAIL peripheral.probe probe "s31-peripheral-test missing"
	fi

	if [ -c /dev/hwrng ] && dd if=/dev/hwrng of=/dev/null bs=32 count=1 2>/dev/null; then
		emit PASS hwrng.read probe "32 bytes read"
	else
		emit FAIL hwrng.read probe "/dev/hwrng read failed"
	fi

	if [ -r /proc/mtd ] && grep -q '^mtd' /proc/mtd; then
		emit PASS mtd.inventory probe "$(grep -c '^mtd' /proc/mtd) partitions"
	else
		emit FAIL mtd.inventory probe "no MTD partitions"
	fi

	check_routes uart1 uart1.tx uart1.rx
	check_routes i2c0 i2c0.scl i2c0.sda
	# GPSPI chip select is a GPIO descriptor, not an interrupt-matrix route.
	check_routes gpspi2 gpspi2.sclk gpspi2.mosi gpspi2.miso
	# The HIL fixture supplies BCK/WS while Linux is the playback slave.
	check_routes i2s0 i2s0.tx-bck-in i2s0.bck-in i2s0.tx-ws-in i2s0.ws-in i2s0.data-out i2s0.data-in
	check_routes twai0 twai0.tx twai0.rx

	# Apply one controller at a time on the fixed HIL lanes.  No data is
	# transmitted and every overlay is removed before the next probe.
	probe_overlay uart1 uart1.tx=42 uart1.rx=43
	probe_overlay i2c0 i2c0.scl=42 i2c0.sda=43
	probe_overlay gpspi2 gpspi2.sclk=42 gpspi2.mosi=43 gpspi2.miso=44
	probe_overlay i2s0 i2s0.tx-bck-in=42 i2s0.bck-in=42 i2s0.tx-ws-in=43 i2s0.ws-in=43 i2s0.data-out=44 i2s0.data-in=45
	probe_overlay twai0 twai0.tx=42 twai0.rx=43

	# Exercise controllers which need no external fixture.  Each dynamic
	# overlay is removed before proceeding so the shared test pins/resources
	# are never left claimed.
	probe_smoke_overlay timers
	probe_smoke_overlay watchdogs
	probe_smoke_overlay pwm-counter
	probe_smoke_overlay analog
	probe_smoke_overlay gdma
	if _crypto_output="$(s31-crypto-test 2>&1)"; then
		emit PASS standalone.crypto.api data \
			"$(printf '%s\n' "$_crypto_output" | head -n 1)"
	else
		emit FAIL standalone.crypto.api data \
			"$(printf '%s\n' "$_crypto_output" | tail -n 1)"
	fi
}

peer_tests()
{
	if [ "$PEER_CONNECTED" -ne 1 ]; then
		emit SKIP peer.gpio-loopback electrical "peer not connected"
		emit SKIP peer.uart electrical "peer not connected"
		emit SKIP peer.i2c electrical "peer not connected"
		emit SKIP peer.spi electrical "peer not connected"
		emit SKIP peer.i2s electrical "peer not connected"
		emit SKIP peer.pwm-counter electrical "peer not connected"
		emit SKIP peer.twai electrical "peer not connected"
		return
	fi
	emit FAIL peer.protocol electrical "peer protocol runner is not armed"
}

ethernet_tests()
{
	added=0
	if [ ! -d /sys/class/net/eth0 ]; then
		if s31-overlay apply gmac --volatile >/dev/null 2>&1; then
			added=1
		else
			emit FAIL ethernet.probe probe "GMAC overlay failed"
			return
		fi
	fi
	if [ ! -d /sys/class/net/eth0 ]; then
		emit FAIL ethernet.probe probe "eth0 missing"
	else
		emit PASS ethernet.probe probe "eth0 registered"
		ip link set eth0 up >/dev/null 2>&1 &
		link_pid=$!
		link_wait=0
		link_timed_out=0
		while kill -0 "$link_pid" >/dev/null 2>&1 && [ "$link_wait" -lt 5 ]; do
			sleep 1
			link_wait=$((link_wait + 1))
		done
		if kill -0 "$link_pid" >/dev/null 2>&1; then
			kill -9 "$link_pid" >/dev/null 2>&1 || true
			emit SKIP ethernet.link electrical "interface up timed out; cable or PHY not ready"
			carrier=0
			link_timed_out=1
		else
		wait "$link_pid" >/dev/null 2>&1 || true
			carrier=0
			carrier_wait=0
			while [ "$carrier" != 1 ] && [ "$carrier_wait" -lt 10 ]; do
				carrier="$(cat /sys/class/net/eth0/carrier 2>/dev/null || echo 0)"
				[ "$carrier" = 1 ] || sleep 1
				carrier_wait=$((carrier_wait + 1))
			done
		fi
		if [ "$link_timed_out" -eq 0 ] && [ "$carrier" != 1 ]; then
			emit SKIP ethernet.link electrical "direct cable not connected or peer link down"
		elif [ "$carrier" = 1 ]; then
			emit PASS ethernet.link electrical "carrier up"
			ip addr replace "$LOCAL_IP" dev eth0 >/dev/null 2>&1
			if ping -c 3 -W 2 "$PEER_IP" >/dev/null 2>&1; then
				emit PASS ethernet.icmp data "peer $PEER_IP replied"
			else
				emit FAIL ethernet.icmp data "peer $PEER_IP did not reply"
			fi
		fi
	fi
	if [ "$added" -eq 1 ]; then
		s31-overlay remove gmac --volatile >/dev/null 2>&1 || \
			emit FAIL ethernet.cleanup probe "failed to remove temporary GMAC overlay"
	fi
}

sdmmc_tests()
{
	added=0
	if ! active_overlay sdmmc0; then
		if s31-overlay apply sdmmc0 bus-width=1 --volatile >/dev/null 2>&1; then
			added=1
		else
			emit FAIL sdmmc.probe probe "SDMMC 1-bit overlay failed"
			return
		fi
	fi
	sleep 2
	disk=""
	for candidate in /dev/mmcblk[0-9]*; do
		[ -b "$candidate" ] || continue
		disk="$candidate"
		break
	done
	if [ -z "$disk" ]; then
		emit SKIP sdmmc.card electrical "SD card not detected"
	elif dd if="$disk" of=/dev/null bs=4096 count=256 2>/dev/null; then
		emit PASS sdmmc.read data "read 1 MiB from $disk"
	else
		emit FAIL sdmmc.read data "read failed from $disk"
	fi
	if [ "$added" -eq 1 ]; then
		if s31-overlay remove sdmmc0 --volatile >/dev/null 2>&1; then
			emit PASS sdmmc.cleanup probe "temporary overlay removed"
		else
			emit FAIL sdmmc.cleanup probe "temporary overlay removal failed"
		fi
	fi
}

find_usb_disk()
{
	for sysdev in /sys/class/block/sd*; do
		[ -e "$sysdev" ] || continue
		case "$(readlink -f "$sysdev")" in
		*/usb*/*) basename "$sysdev"; return 0 ;;
		esac
	done
	return 1
}

usb_drive_tests()
{
	modprobe sd_mod >/dev/null 2>&1 || true
	modprobe usb_storage >/dev/null 2>&1 || true
	sleep 2
	if ! disk="$(find_usb_disk)"; then
		emit SKIP usb.drive electrical "USB mass-storage drive not connected"
		return
	fi
	emit PASS usb.drive.enumerate electrical "/dev/$disk"
	partition=""
	for candidate in /dev/${disk}[0-9]*; do
		[ -b "$candidate" ] || continue
		partition="$candidate"
		break
	done
	[ -n "$partition" ] || partition="/dev/$disk"
	mountpoint=/mnt/hil-usb
	mkdir -p "$mountpoint"
	if mount -o ro "$partition" "$mountpoint" >/dev/null 2>&1; then
		emit PASS usb.drive.mount data "$partition mounted read-only"
		umount "$mountpoint" >/dev/null 2>&1 || \
			emit FAIL usb.drive.unmount data "unmount failed"
	else
		emit FAIL usb.drive.mount data "cannot mount $partition read-only"
		return
	fi
	if [ "$ALLOW_USB_WRITE" -eq 1 ]; then
		if mount "$partition" "$mountpoint" >/dev/null 2>&1; then
			probe="$mountpoint/.s31-hil-probe-$$"
			if dd if=/dev/urandom of="$probe" bs=4096 count=16 conv=fsync 2>/dev/null &&
			   sha256sum "$probe" >/dev/null 2>&1; then
				emit PASS usb.drive.write data "64 KiB create/readback succeeded"
				rm -f "$probe"
				sync
			else
				emit FAIL usb.drive.write data "write/readback failed"
			fi
			umount "$mountpoint" >/dev/null 2>&1 || \
				emit FAIL usb.drive.unmount data "unmount after write failed"
		else
			emit FAIL usb.drive.write data "read-write mount failed"
		fi
	else
		emit SKIP usb.drive.write destructive "requires --allow-usb-write"
	fi
}

mtd_tests()
{
	mtd_num="$(awk -F: '$2 ~ /\"hil-scratch\"/ { sub(/^mtd/, "", $1); print $1 }' /proc/mtd 2>/dev/null)"
	if [ -z "$mtd_num" ] || [ ! -c "/dev/mtd$mtd_num" ]; then
		emit FAIL mtd.scratch.probe probe "dedicated hil-scratch MTD partition missing"
		return
	fi
	emit PASS mtd.scratch.probe probe "/dev/mtd$mtd_num is dedicated hil-scratch"
	rm -f /tmp/hil-mtd-stop /tmp/hil-mtd-cpu0 /tmp/hil-mtd-cpu1
	taskset -c 0 sh -c 'n=0; while [ ! -e /tmp/hil-mtd-stop ]; do sha256sum /bin/busybox >/dev/null || exit 1; n=$((n + 1)); echo $n >/tmp/hil-mtd-cpu0; done' &
	pid0=$!
	taskset -c 1 sh -c 'n=0; while [ ! -e /tmp/hil-mtd-stop ]; do sha256sum /bin/busybox >/dev/null || exit 1; n=$((n + 1)); echo $n >/tmp/hil-mtd-cpu1; done' &
	pid1=$!
	sleep 1
	before0="$(cat /tmp/hil-mtd-cpu0 2>/dev/null || echo 0)"
	before1="$(cat /tmp/hil-mtd-cpu1 2>/dev/null || echo 0)"
	if output="$(s31-hil-io mtd-test "/dev/mtd$mtd_num" 4 2>&1)"; then
		emit PASS mtd.scratch.program-erase destructive "$(printf '%s\n' "$output" | tail -n 1)"
	else
		emit FAIL mtd.scratch.program-erase destructive "$(printf '%s\n' "$output" | tail -n 1)"
	fi
	touch /tmp/hil-mtd-stop
	wait "$pid0"; rc0=$?
	wait "$pid1"; rc1=$?
	after0="$(cat /tmp/hil-mtd-cpu0 2>/dev/null || echo 0)"
	after1="$(cat /tmp/hil-mtd-cpu1 2>/dev/null || echo 0)"
	if [ "$rc0" -eq 0 ] && [ "$rc1" -eq 0 ] &&
	   [ "$after0" -gt "$before0" ] && [ "$after1" -gt "$before1" ]; then
		emit PASS mtd.xip-smp concurrency "cpu0=$before0->$after0 cpu1=$before1->$after1; both XIP workers resumed"
	else
		emit FAIL mtd.xip-smp concurrency "cpu0=$before0->$after0 rc=$rc0 cpu1=$before1->$after1 rc=$rc1"
	fi
	rm -f /tmp/hil-mtd-stop /tmp/hil-mtd-cpu0 /tmp/hil-mtd-cpu1
}

lp_core_tests()
{
	added=0
	if ! active_overlay lp; then
		if s31-overlay apply lp --volatile >/dev/null 2>&1; then
			added=1
		else
			emit FAIL lp.overlay probe "LP overlay failed"
			return
		fi
	fi
	sleep 1
	if bounded_run 3 s31-lpctl status; then
		status="$BOUNDED_OUTPUT"
	else
		status="$BOUNDED_OUTPUT"
	fi
	if [ "$BOUNDED_RC" -eq 0 ] &&
	   printf '%s\n' "$status" | grep -q '^ready=1'; then
		emit PASS lp.ready probe "LP remoteproc bound and ready"
	else
		emit FAIL lp.ready probe "$(printf '%s\n' "$status" | tail -n 1)"
	fi
	if bounded_run 3 s31-lpctl ping; then
		ping="$BOUNDED_OUTPUT"
		emit PASS lp.mailbox-ping data "$(printf '%s\n' "$ping" | tail -n 1)"
	else
		ping="$BOUNDED_OUTPUT"
		emit FAIL lp.mailbox-ping data "$(printf '%s\n' "$ping" | tail -n 1)"
	fi
	reply=""
	reply_log=""
	if bounded_run 3 s31-lpctl send 0x12345678; then
		# The misc-device FIFO intentionally records every LP response,
		# including suspend RPC traffic.  Scan its full bounded depth so a
		# preceding power-wake case cannot hide this request's response behind
		# valid stale messages.
		_lp_read=0
		while [ "$_lp_read" -lt 64 ]; do
			_lp_read=$((_lp_read + 1))
			if ! bounded_run 3 s31-lpctl recv; then
				break
			fi
			reply="$BOUNDED_OUTPUT"
			reply_log="${reply_log}${reply_log:+,}$reply"
			[ "$reply" = ffff5678 ] && break
		done
	fi
	if [ "$reply" = ffff5678 ]; then
		bounded_run 3 s31-lpctl status || true
		after="$(printf '%s' "$BOUNDED_OUTPUT" | tr '\n' ' ')"
		emit PASS lp.shared-message data "request=12345678 reads=$reply_log ${after}"
	else
		emit FAIL lp.shared-message data "request=12345678 reads=${reply_log:-unavailable}"
	fi
	if [ "$added" -eq 1 ]; then
		if s31-overlay remove lp --volatile >/dev/null 2>&1; then
			emit PASS lp.cleanup recovery "temporary overlay removed"
		else
			emit FAIL lp.cleanup recovery "temporary overlay removal failed"
		fi
	fi
	online="$(cat /sys/devices/system/cpu/online 2>/dev/null || true)"
	case "$online" in
	0-1|0,1) emit PASS lp.smp-recovery recovery "online=$online" ;;
	*) emit FAIL lp.smp-recovery recovery "expected CPUs 0-1, got ${online:-unavailable}" ;;
	esac
}

bounded_run()
{
	_bounded_seconds="$1"
	shift
	_bounded_file=/tmp/s31-hil-bounded.$$
	"$@" >"$_bounded_file" 2>&1 &
	_bounded_pid=$!
	_bounded_wait=0
	while kill -0 "$_bounded_pid" >/dev/null 2>&1 &&
	      [ "$_bounded_wait" -lt "$_bounded_seconds" ]; do
		sleep 1
		_bounded_wait=$((_bounded_wait + 1))
	done
	if kill -0 "$_bounded_pid" >/dev/null 2>&1; then
		kill "$_bounded_pid" >/dev/null 2>&1 || true
		wait "$_bounded_pid" >/dev/null 2>&1 || true
		BOUNDED_RC=124
	else
		wait "$_bounded_pid"
		BOUNDED_RC=$?
	fi
	BOUNDED_OUTPUT="$(cat "$_bounded_file" 2>/dev/null || true)"
	rm -f "$_bounded_file"
	[ "$BOUNDED_RC" -eq 0 ]
}

irq_line_count()
{
	awk '{ sum=0; for (i=2; i<=NF && $i ~ /^[0-9]+$/; i++) sum += $i; print sum+0 }'
}

smp_irq_dma_tests()
{
	radio_started=0
	if ! find /sys -type f -name radio_health 2>/dev/null | grep -q .; then
		if S31_RADIO_VOLATILE_MODE=wifi /etc/init.d/S00s31-radio start; then
			radio_started=1
		fi
	fi
	stress_log=/tmp/s31-hil-stress.$$
	if bounded_run 90 s31-selftest --stress --duration 10 --json; then
		printf '%s\n' "$BOUNDED_OUTPUT" >"$stress_log"
	else
		printf '%s\n' "$BOUNDED_OUTPUT" >"$stress_log"
	fi
	if [ "$BOUNDED_RC" -eq 0 ] &&
	   grep -q '"status":"PASS","test":"summary"' "$stress_log"; then
		cpu0="$(grep '"test":"stress.cpu0"' "$stress_log" | tail -n 1 | sed -n 's/.*"detail":"\([^"]*\)".*/\1/p')"
		cpu1="$(grep '"test":"stress.cpu1"' "$stress_log" | tail -n 1 | sed -n 's/.*"detail":"\([^"]*\)".*/\1/p')"
		emit PASS smp.concurrent-load stress "cpu0=$cpu0 cpu1=$cpu1; CPUs remained online"
		emit PASS smp.xip-persist-radio stress "XIP, persist, radio-health/drop and kernel-log gates passed"
	else
		detail="$(grep '"status":"FAIL"' "$stress_log" 2>/dev/null | head -n 2 | tr '\n' ' ')"
		emit FAIL smp.concurrent-load stress "${detail:-selftest timed out or emitted no summary}"
	fi
	rm -f "$stress_log"
	if [ "$radio_started" -eq 1 ]; then
		/etc/init.d/S00s31-radio stop >/dev/null 2>&1 || true
		s31-overlay remove radio-wifi --volatile >/dev/null 2>&1 || true
	fi

	added=0
	if ! active_overlay gdma; then
		if s31-overlay apply gdma --volatile >/dev/null 2>&1; then
			added=1
		else
			emit FAIL dma.overlay probe "GDMA test overlay failed"
			return
		fi
	fi
	if [ -d /sys/class/dma/dma0chan4 ] &&
	   { [ -d /sys/module/dmatest ] || modprobe dmatest >/dev/null 2>&1; }; then
		rx_line="$(awk '$5 == 40 && /20343000.dma-controller/' /proc/interrupts)"
		tx_line="$(awk '$5 == 45 && /20343000.dma-controller/' /proc/interrupts)"
		rx_before="$(printf '%s\n' "$rx_line" | irq_line_count)"
		tx_before="$(printf '%s\n' "$tx_line" | irq_line_count)"
		echo 65536 >/sys/module/dmatest/parameters/test_buf_size
		echo 8 >/sys/module/dmatest/parameters/iterations
		echo 3000 >/sys/module/dmatest/parameters/timeout
		echo dma0chan4 >/sys/module/dmatest/parameters/channel
		result_pattern='dmatest: dma0chan4-copy0: summary 8 tests'
		before_results="$(dmesg | grep -c "$result_pattern")"
		echo 1 >/sys/module/dmatest/parameters/run
		sleep 8
		echo 0 >/sys/module/dmatest/parameters/run
		result="$(dmesg | grep "$result_pattern" |
			sed -n "$((before_results + 1))p")"
		rx_line="$(awk '$5 == 40 && /20343000.dma-controller/' /proc/interrupts)"
		tx_line="$(awk '$5 == 45 && /20343000.dma-controller/' /proc/interrupts)"
		rx_after="$(printf '%s\n' "$rx_line" | irq_line_count)"
		tx_after="$(printf '%s\n' "$tx_line" | irq_line_count)"
		if printf '%s\n' "$result" | grep -q '8 tests, 0 failures'; then
			emit PASS dma.memcpy data "$result"
		else
			emit FAIL dma.memcpy data "${result:-no dmatest result}"
		fi
		if [ "$rx_after" -gt "$rx_before" ] && [ "$tx_after" -gt "$tx_before" ]; then
			emit PASS dma.irq-progress irq "rx=$rx_before->$rx_after tx=$tx_before->$tx_after"
		else
			emit FAIL dma.irq-progress irq "rx=$rx_before->$rx_after tx=$tx_before->$tx_after"
		fi
		modprobe -r dmatest >/dev/null 2>&1 || true
	else
		emit FAIL dma.channel probe "dma0chan4 or dmatest unavailable"
	fi
	if [ "$added" -eq 1 ]; then
		if s31-overlay remove gdma --volatile >/dev/null 2>&1; then
			emit PASS dma.cleanup recovery "temporary overlay removed"
		else
			emit FAIL dma.cleanup recovery "temporary overlay removal failed"
		fi
	fi
}

case "$CASE" in
firmware) firmware_tests; peer_tests ;;
peer) peer_tests ;;
sdmmc) sdmmc_tests ;;
ethernet) ethernet_tests ;;
usb-drive) usb_drive_tests ;;
mtd) mtd_tests ;;
lp-core) lp_core_tests ;;
smp-irq-dma) smp_irq_dma_tests ;;
all) firmware_tests; peer_tests; sdmmc_tests; ethernet_tests; usb_drive_tests; mtd_tests; lp_core_tests; smp_irq_dma_tests ;;
*) usage; exit 2 ;;
esac

status=PASS
[ "$FAIL_COUNT" -eq 0 ] || status=FAIL
printf 'HIL1 {"board":"esp32-s31","status":"%s","test":"summary","level":"summary","case":"%s","pass":%u,"fail":%u,"skip":%u}\n' \
	"$status" "$CASE" "$PASS_COUNT" "$FAIL_COUNT" "$SKIP_COUNT"
[ "$FAIL_COUNT" -eq 0 ]
