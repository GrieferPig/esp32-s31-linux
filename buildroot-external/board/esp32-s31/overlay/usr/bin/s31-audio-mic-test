#!/bin/sh

set -eu

capture="/tmp/s31-ambient-mic-u16.raw"
trap 'rm -f "$capture"' EXIT

echo "Recording the ES8311 ambient microphone for two seconds..."
arecord -q -D hw:0,1 -t raw -f U16_LE -r 48000 -c 1 -d 2 "$capture"
s31-audio-analyze "$capture"
echo "PASS: ES8311 ADC -> I2S -> FreeRTOS -> shared ring -> ALSA capture"
