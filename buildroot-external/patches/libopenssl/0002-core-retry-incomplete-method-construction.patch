Subject: [PATCH] core: retry incomplete method construction after allocation failure

Method construction can fail before an implementation reaches the store.
Do not mark that provider operation fully constructed in that case, or the
missing algorithm remains unavailable for the life of the library context.
Track failures per provider/operation and permit a later fetch to finish.

Distinguish an existing equivalent implementation from insertion failure so
retries can complete without keeping the operation permanently uncached.
Drop the unused temporary reference in both duplicate and failure cases.
Treat failed name registration as a construction error as well.

--- a/crypto/core_fetch.c
+++ b/crypto/core_fetch.c
@@ -21,6 +21,7 @@
     OSSL_METHOD_STORE *store;
     int operation_id;
     int force_store;
+    int construction_failed;
     OSSL_METHOD_CONSTRUCT_METHOD *mcm;
     void *mcm_data;
 };
@@ -68,6 +69,7 @@
 
     /* Assume that no bits are set */
     *result = 0;
+    ((struct construct_data_st *)cbdata)->construction_failed = 0;
 
     /* No flag bits for temporary stores */
     if (!is_temporary_method_store(no_store, cbdata)
@@ -95,6 +97,12 @@
 
     *result = 1;
 
+    /* A partially populated store must be retried after allocation recovery. */
+    if (((struct construct_data_st *)cbdata)->construction_failed) {
+        *result = 0;
+        return 1;
+    }
+
     /* No flag bits for temporary stores */
     return is_temporary_method_store(no_store, cbdata)
         || ossl_provider_set_operation_bit(provider, operation_id);
@@ -108,24 +116,18 @@
     void *method = NULL;
 
     if ((method = data->mcm->construct(algo, provider, data->mcm_data))
-        == NULL)
+        == NULL) {
+        data->construction_failed = 1;
         return;
+    }
 
     OSSL_TRACE2(QUERY,
         "ossl_method_construct_this: putting an algo to the store %p with no_store %d\n",
         (void *)data->store, no_store);
-    /*
-     * Note regarding putting the method in stores:
-     *
-     * we don't need to care if it actually got in or not here.
-     * If it didn't get in, it will simply not be available when
-     * ossl_method_construct() tries to get it from the store.
-     *
-     * It is *expected* that the put function increments the refcnt
-     * of the passed method.
-     */
-    data->mcm->put(no_store ? data->store : NULL, method, provider, algo->algorithm_names,
-        algo->property_definition, data->mcm_data);
+    /* A positive put also covers an implementation already in the store. */
+    if (!data->mcm->put(no_store ? data->store : NULL, method, provider,
+            algo->algorithm_names, algo->property_definition, data->mcm_data))
+        data->construction_failed = 1;
 
     /* refcnt-- because we're dropping the reference */
     data->mcm->destruct(method, data->mcm_data);
--- a/crypto/property/property.c
+++ b/crypto/property/property.c
@@ -306,7 +306,7 @@
  * @param method_up_ref Function pointer for incrementing the method ref count.
  * @param method_destruct Function pointer for destroying the method.
  *
- * @return 1 if the method is successfully added, 0 on failure.
+ * @return 1 if added, 2 if an equivalent implementation exists, 0 on failure.
  *
  * If tracing is enabled, a message is printed indicating that the method is
  * being added to the method store.
@@ -406,8 +406,10 @@
             break;
     }
 
-    if (i == sk_IMPLEMENTATION_num(alg->impls)
-        && sk_IMPLEMENTATION_push(alg->impls, impl)) {
+    if (i < sk_IMPLEMENTATION_num(alg->impls)) {
+        /* A retry can encounter implementations committed before a failure. */
+        ret = 2;
+    } else if (sk_IMPLEMENTATION_push(alg->impls, impl)) {
         ret = 1;
 #ifndef FIPS_MODULE
         OSSL_TRACE_BEGIN(QUERY)
@@ -421,7 +423,7 @@
 #endif
     }
     ossl_property_unlock(store);
-    if (ret == 0)
+    if (ret != 1)
         impl_free(impl);
     return ret;
 
--- a/crypto/evp/evp_fetch.c
+++ b/crypto/evp/evp_fetch.c
@@ -224,8 +224,10 @@
     int name_id = ossl_namemap_add_names(namemap, 0, names, NAME_SEPARATOR);
     void *method;
 
-    if (name_id == 0)
-        return NULL;
+    if (name_id == 0) {
+        methdata->flag_construct_error_occurred = 1;
+        return NULL;
+    }
 
     method = methdata->method_from_algorithm(name_id, algodef, prov);
 
