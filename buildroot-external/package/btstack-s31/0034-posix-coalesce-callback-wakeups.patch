From: ESP32-S31 Linux <s31-linux@example.invalid>
Subject: [PATCH] posix: optionally coalesce callback pipe wakeups

The callback consumer drains work queued recursively while processing. Writing
a pipe byte for each such enqueue leaves stale wakeups for empty-list passes.
Keep legacy behavior by default for same-image A/B. With
S31_BTSTACK_COALESCE_WAKEUPS=1, guard the consumer-active state and the
empty-to-nonempty wake decision with the existing callback mutex.
---
--- a/platform/posix/btstack_run_loop_posix.c
+++ b/platform/posix/btstack_run_loop_posix.c
@@ -71,6 +71,9 @@
 static pthread_mutex_t       btstack_run_loop_posix_callbacks_mutex = PTHREAD_MUTEX_INITIALIZER;
 static int                   btstack_run_loop_posix_process_callbacks_fd;
 static btstack_data_source_t btstack_run_loop_posix_process_callbacks_ds;
+/* Protected by callbacks_mutex, including the producer's wake decision. */
+static bool s31_callbacks_processing;
+static bool s31_callbacks_coalesce;
 
 // to trigger poll data sources from irq
 static int                   btstack_run_loop_posix_poll_data_sources_fd;
@@ -294,6 +297,9 @@
 
 static void btstack_run_loop_posix_process_callbacks_handler(btstack_data_source_t * ds, btstack_data_source_callback_type_t callback_type){
     UNUSED(callback_type);
+    pthread_mutex_lock(&btstack_run_loop_posix_callbacks_mutex);
+    s31_callbacks_processing = true;
+    pthread_mutex_unlock(&btstack_run_loop_posix_callbacks_mutex);
     uint8_t buffer[1];
     ssize_t bytes_read = read(ds->source.fd, buffer, 1);
     UNUSED(bytes_read);
@@ -301,6 +307,7 @@
     while (1){
         pthread_mutex_lock(&btstack_run_loop_posix_callbacks_mutex);
         btstack_context_callback_registration_t * callback_registration = (btstack_context_callback_registration_t *) btstack_linked_list_pop(&btstack_run_loop_base_callbacks);
+        if (callback_registration == NULL) s31_callbacks_processing = false;
         pthread_mutex_unlock(&btstack_run_loop_posix_callbacks_mutex);
         if (callback_registration == NULL){
             break;
@@ -312,10 +319,13 @@
 static void btstack_run_loop_posix_execute_on_main_thread(btstack_context_callback_registration_t * callback_registration){
     // protect list with mutex
     pthread_mutex_lock(&btstack_run_loop_posix_callbacks_mutex);
+    bool wake = !s31_callbacks_coalesce ||
+        (!s31_callbacks_processing && btstack_run_loop_base_callbacks == NULL);
     btstack_run_loop_base_add_callback(callback_registration);
     pthread_mutex_unlock(&btstack_run_loop_posix_callbacks_mutex);
-    // trigger run loop
-    btstack_run_loop_posix_trigger_pipe(btstack_run_loop_posix_process_callbacks_fd);
+    /* An active consumer drains newly queued work before it goes idle.
+     * Otherwise only the empty-to-nonempty transition needs a pipe byte. */
+    if (wake) btstack_run_loop_posix_trigger_pipe(btstack_run_loop_posix_process_callbacks_fd);
 }
 
 //init
@@ -337,6 +347,10 @@
 
 static void btstack_run_loop_posix_init(void){
     btstack_run_loop_base_init();
+    const char * coalesce = getenv("S31_BTSTACK_COALESCE_WAKEUPS");
+    s31_callbacks_coalesce = coalesce != NULL && coalesce[0] == '1' && coalesce[1] == 0;
+    s31_callbacks_processing = false;
+    fprintf(stderr, "S31 callback wakeups: %s\n", s31_callbacks_coalesce ? "coalesced" : "legacy");
     
 #ifdef _POSIX_MONOTONIC_CLOCK
     clock_gettime(CLOCK_MONOTONIC, &init_ts);
