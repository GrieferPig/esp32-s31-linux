From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ESP32-S31 Linux <s31-linux@example.invalid>
Date: Tue, 6 Oct 2026 12:00:00 +0800
Subject: [PATCH] a2dp: bond and auto-confirm Just Works LE pairing

BlueZ `pair` requests bonding, but the peripheral offered no bonding
(auth requirements 0: no LTK distribution), so a bond could never
complete.  Worse, nobody answered SM_EVENT_JUST_WORKS_REQUEST, so the
SM responder parked in SM_PH1_W4_USER_RESPONSE and the initiator hit its
30 s SMP timeout (disconnect reason 0x05).  Request bonding (method stays
Just Works via NoInputNoOutput, no MITM) and auto-confirm through a
dedicated SM event handler: SM events travel on the sm_add_event_handler
list, not the HCI list, and this NoIO appliance has no user to ask,
matching the existing Classic SSP auto-accept.
---
 example/a2dp_sink_demo.c | 31 ++++++++++++++++++++++++++++++-
 1 file changed, 30 insertions(+), 1 deletion(-)

--- a/example/a2dp_sink_demo.c
+++ b/example/a2dp_sink_demo.c
@@ -355,7 +355,10 @@
     uint8_t name_length = (uint8_t) strlen(s31_device_name);
 
     sm_set_io_capabilities(IO_CAPABILITY_NO_INPUT_NO_OUTPUT);
-    sm_set_authentication_requirements(0);
+    /* Bonding is required: without SM_AUTHREQ_BONDING the responder
+     * offers no LTK distribution and BlueZ `pair` can never complete.
+     * NoInputNoOutput keeps the method Just Works (no MITM). */
+    sm_set_authentication_requirements(SM_AUTHREQ_BONDING);
 
     att_db_util_init();
     att_db_util_add_service_uuid16(ORG_BLUETOOTH_SERVICE_GENERIC_ACCESS);
@@ -488,6 +491,9 @@
     hci_event_callback_registration.callback = &hci_packet_handler;
     hci_add_event_handler(&hci_event_callback_registration);
 
+    s31_sm_event_callback_registration.callback = &s31_sm_packet_handler;
+    sm_add_event_handler(&s31_sm_event_callback_registration);
+
     const char * coex_env = getenv("S31_BTSTACK_COEX");
     s31_coex_enabled = coex_env != NULL && strcmp(coex_env, "0") != 0;
     printf("ESP-IDF A2DP coexistence status: %s\n",
@@ -948,6 +954,28 @@
                s31_coex_applied_streaming ? "streaming" : "stopped");
     }
     s31_coex_pump();
+}
+
+/* SM events arrive on the dedicated SM handler list
+ * (sm_add_event_handler), not the HCI list: without this registration
+ * SM_EVENT_JUST_WORKS_REQUEST would never be seen and the responder
+ * would park in SM_PH1_W4_USER_RESPONSE until the 30 s timeout. */
+static btstack_packet_callback_registration_t s31_sm_event_callback_registration;
+
+static void s31_sm_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size){
+    UNUSED(channel);
+    UNUSED(size);
+    if (packet_type != HCI_EVENT_PACKET) return;
+    switch (hci_event_packet_get_type(packet)){
+        case SM_EVENT_JUST_WORKS_REQUEST:
+            /* NoIO appliance: no user exists to confirm.  Same policy
+             * as the Classic SSP auto-accept in hci_packet_handler. */
+            printf("S31 LE Just Works pairing auto-confirmed\n");
+            sm_just_works_confirm(sm_event_just_works_request_get_handle(packet));
+            break;
+        default:
+            break;
+    }
 }
 
 static void hci_packet_handler(uint8_t packet_type, uint16_t channel, uint8_t *packet, uint16_t size){
